{
  "name": "prompt-box",
  "version": "0.1.0",
  "description": "极简提示词管理工具 — 随时记录、分类管理、一键取用",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "build": "node scripts/build-target.mjs chrome-local",
    "build:chrome-sync": "node scripts/build-target.mjs chrome-sync",
    "build:gpt-sync": "node scripts/build-target.mjs gpt-sync",
    "build:sync": "node scripts/build-target.mjs chrome-sync && node scripts/build-target.mjs gpt-sync",
    "showcase:screenshot": "node scripts/showcase-screenshot.mjs",
    "zip": "wxt zip",
    "sync:start": "node --experimental-strip-types tools/local-sync/server.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.js",
    "typecheck": "vue-tsc --noEmit",
    "check:arch": "node scripts/check-architecture.mjs",
    "verify": "npm run typecheck && npm run check:arch",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.3",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.3.11",
    "wxt": "^0.21.4"
  }
}
